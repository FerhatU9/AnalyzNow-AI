# Local AnalyzNow AI configuration. Copy to .env and supply your own secrets.
# Never commit .env or actual credentials.

POSTGRES_PASSWORD=replace_with_a_strong_local_password
FOOTBALL_DATA_SOURCE=postgres
FOOTBALL_CSV_PATH=data/synthetic_demo.csv

# Optional: required for live bookmaker odds requests.
ODDS_API_KEY=

# Optional Docker networking overrides; leave unset for existing Windows/local API.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=analyznow_demo
# POSTGRES_USER=analyznow_demo
# The isolated Compose demo sets these internally; do not change local credentials.

# Optional local-only OpenTelemetry span output (off by default).
# ANALYZNOW_TRACE_CONSOLE=1
